# Local development (PostgreSQL on localhost)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enrollment_db

# Docker Compose uses DATABASE_URL=postgresql://postgres:postgres@db:5432/enrollment_db
# (set automatically in docker-compose.yml — no change needed for Docker)

SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
